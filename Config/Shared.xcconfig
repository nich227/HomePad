// Shared by the app and its extensions.
// HOMEPAD_BUNDLE_PREFIX and HOMEPAD_APP_GROUP must match HomePadIdentifiers in Packages/HomePadCore.

HOMEPAD_BUNDLE_PREFIX = com.kevster.HomePad
HOMEPAD_APP_GROUP = group.com.kevster.HomePad

DEVELOPMENT_TEAM = 8ZUR795GTN
CODE_SIGN_STYLE = Automatic

MARKETING_VERSION = 0.1.0
CURRENT_PROJECT_VERSION = 1

// iPhone and iPad only, iOS and iPadOS 26 or later.
IPHONEOS_DEPLOYMENT_TARGET = 26.0
TARGETED_DEVICE_FAMILY = 1,2
SUPPORTED_PLATFORMS = iphoneos iphonesimulator
SUPPORTS_MACCATALYST = NO
SUPPORTS_MAC_DESIGNED_FOR_IPHONE_IPAD = NO
SUPPORTS_XR_DESIGNED_FOR_IPHONE_IPAD = NO

SWIFT_VERSION = 6.0
SWIFT_STRICT_CONCURRENCY = complete
ENABLE_USER_SCRIPT_SANDBOXING = YES
